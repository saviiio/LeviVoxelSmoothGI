    "enabled": {"type":"boolean","default":true,"title":"Enabled","description":"Enable the native mod."},
    "shaderCache": {"type":"boolean","default":true},
    "deferShaderCompilation": {"type":"boolean","default":false},
    "parallelCompile": {"type":"boolean","default":true},
    "voxelCapture": {"type":"boolean","default":true},
    "hierarchicalDdaReflections": {"type":"boolean","default":true},
    "directionalFloodfillGi": {"type":"boolean","default":true},
    "disableNativeSsr": {"type":"boolean","default":true},
    "logStalls": {"type":"boolean","default":true},
    "prewarmItemPipelines": {"type":"boolean","default":true},
    "fixScreenEdgeRow": {"type":"boolean","default":false},
    "voxelX": {"type":"integer","default":64,"minimum":24,"maximum":128},
    "voxelY": {"type":"integer","default":40,"minimum":16,"maximum":96},
    "voxelZ": {"type":"integer","default":64,"minimum":24,"maximum":128},
    "reflectionRange": {"type":"number","default":48.0,"minimum":4,"maximum":128},
    "reflectionStrength": {"type":"number","default":0.7,"minimum":0,"maximum":2},
    "giStrength": {"type":"number","default":1.15,"minimum":0,"maximum":3},
    "giDecay": {"type":"number","default":0.935,"minimum":0.5,"maximum":0.99},
