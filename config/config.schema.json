    "binaryCaptureDelayFrames": {"type":"integer","default":180,"minimum":0,"maximum":2000},
    "binaryCaptureIntervalFrames": {"type":"integer","default":9,"minimum":1,"maximum":120},
    "stallLogMs": {"type":"number","default":9.0,"minimum":1,"maximum":100},
    "compilerThreads": {"type":"integer","default":6,"minimum":1,"maximum":16},
    "prewarmStartDelayFrames": {"type":"integer","default":10,"minimum":0,"maximum":1200},
    "prewarmProgramsPerFrame": {"type":"integer","default":2,"minimum":0,"maximum":8},
    "prewarmMaxPending": {"type":"integer","default":12,"minimum":1,"maximum":64},
    "minecraftHookWarningMs": {"type":"integer","default":15000,"minimum":1000,"maximum":120000}
